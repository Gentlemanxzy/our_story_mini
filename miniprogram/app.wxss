/**
 * 全局样式 · 奶油纸感手账风
 * 设计变量集中在 page 上，页面只用变量，不写死颜色。
 */
page {
  /* 纸面 */
  --paper: #FDFBF7;
  --paper-2: #F8F3EA;
  --paper-3: #F1E9DC;
  /* 墨色 */
  --ink: #3D3630;
  --ink-2: #6E645B;
  --ink-3: #A99F94;
  /* 线与强调 */
  --line: #E8DFD1;
  --accent: #C2603F;
  --accent-soft: #F6E6DC;
  --cool: #8C9AA6;
  --cool-soft: #E9EEF1;

  --radius: 24rpx;
  --shadow: 0 2rpx 16rpx rgba(120, 100, 80, 0.05);

  background: var(--paper);
  color: var(--ink);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.65;
  -webkit-font-smoothing: antialiased;
}

view,
text,
input,
textarea,
button {
  box-sizing: border-box;
}

/* 衬线标题，只用于页面标题与数字 */
.serif {
  font-family: "Songti SC", "Noto Serif CJK SC", "STSong", Georgia, serif;
  letter-spacing: 0.02em;
}

/* 页面容器：统一左右留白 + 底部安全区 */
.page {
  padding: 0 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

/* 卡片 */
.card {
  background: #FFFFFF;
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}

/* 细分隔线 */
.hairline {
  height: 1rpx;
  background: var(--line);
}

/* 文本层级 */
.t-title {
  font-size: 40rpx;
  color: var(--ink);
}

.t-sub {
  font-size: 26rpx;
  color: var(--ink-2);
}

.t-hint {
  font-size: 24rpx;
  color: var(--ink-3);
}

/* 重置 button 默认样式 */
button {
  padding: 0;
  margin: 0;
  background: transparent;
  line-height: inherit;
  font-size: inherit;
  color: inherit;
}

button::after {
  border: none;
}

/* 主按钮 */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: 46rpx;
  background: var(--accent);
  color: #FFF9F4;
  font-size: 30rpx;
  letter-spacing: 0.05em;
}

.btn-primary.is-plain {
  background: transparent;
  border: 1rpx solid var(--line);
  color: var(--ink-2);
}

/* 空状态 */
.empty {
  padding: 120rpx 40rpx;
  text-align: center;
  color: var(--ink-3);
  font-size: 26rpx;
  line-height: 1.9;
}

/* 进度条（全站共用，页面只补 margin） */
.bar {
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--paper-3);
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #D98A63, #C2603F);
  transition: width 0.4s ease;
}
