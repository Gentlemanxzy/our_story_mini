<view class="mask {{visible ? 'is-open' : ''}}" catchtap="onClose" catchtouchmove="noop">
  <view class="sheet" catchtap="noop">
    <view class="grip"></view>

    <view class="sheet-head">
      <text class="sheet-title serif">{{thing.title}}</text>
      <text class="sheet-close t-hint" bindtap="onClose">关闭</text>
    </view>

    <scroll-view scroll-y class="sheet-body">
      <view class="field">
        <text class="label">分类</text>
        <view class="cat-field" bindtap="onOpenCat">
          <text class="cat-value">{{catName}}</text>
          <text class="cat-arrow">›</text>
        </view>
      </view>

      <view class="field">
        <text class="label">现在到哪一步了</text>
        <view class="chips">
          <view
            wx:for="{{statuses}}"
            wx:key="key"
            class="chip {{form.status === item.key ? 'is-on' : ''}}"
            data-key="{{item.key}}"
            bindtap="onStatusTap"
          >{{item.name}}</view>
        </view>
      </view>

      <view class="field" wx:if="{{form.status === 'treasured'}}">
        <text class="label">完成日期</text>
        <picker mode="date" value="{{form.doneDate}}" end="{{today}}" bindchange="onDateChange">
          <view class="picker">{{form.doneDate || '选择日期'}}</view>
        </picker>
      </view>

      <view class="field">
        <text class="label">当时的心情</text>
        <view class="moods">
          <view
            wx:for="{{moods}}"
            wx:key="key"
            class="mood {{form.mood === item.key ? 'is-on' : ''}}"
            data-key="{{item.key}}"
            bindtap="onMoodTap"
          >
            <text class="mood-glyph">{{item.glyph}}</text>
            <text class="mood-name">{{item.name}}</text>
          </view>
        </view>
      </view>

      <view class="field">
        <view class="label-row">
          <text class="label">那天的照片</text>
          <text class="t-hint">{{photos.length}}/{{maxPhotos}}</text>
        </view>
        <view class="photos">
          <view wx:for="{{photos}}" wx:key="*this" class="photo">
            <image
              class="photo-img"
              src="{{item}}"
              mode="aspectFill"
              data-index="{{index}}"
              bindtap="onPreviewPhoto"
            />
            <view class="photo-del" data-index="{{index}}" catchtap="onRemovePhoto">×</view>
          </view>
          <view
            wx:if="{{photos.length < maxPhotos}}"
            class="photo photo-add"
            bindtap="onChoosePhoto"
          >
            <text class="photo-plus">＋</text>
            <text class="photo-add-text">加照片</text>
          </view>
        </view>
        <text wx:if="{{localPhotos > 0}}" class="t-hint photo-tip">
          有 {{localPhotos}} 张暂存在本机，连上云端后会自动上传
        </text>
      </view>

      <view class="field">
        <text class="label">写一句话</text>
        <textarea
          class="note"
          value="{{form.note}}"
          maxlength="140"
          placeholder="那天发生了什么…"
          placeholder-class="note-ph"
          bindinput="onNoteInput"
        />
        <text class="t-hint counter">{{form.note.length}}/140</text>
      </view>
    </scroll-view>

    <view class="btn-primary save" bindtap="onSave">记下来</view>
  </view>
</view>

<category-picker
  visible="{{catPickerVisible}}"
  list="{{catList}}"
  value="{{form.category}}"
  bind:close="onCatPickerClose"
  bind:select="onCatSelect"
  bind:create="onCatCreate"
/>
