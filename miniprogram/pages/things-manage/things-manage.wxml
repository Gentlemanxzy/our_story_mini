<view class="page">
  <!-- 新建一件小事 -->
  <view class="card block">
    <view class="block-head">
      <text class="block-title serif">新建一件小事</text>
    </view>

    <input
      class="text-input"
      value="{{newTitle}}"
      maxlength="30"
      placeholder="想和对方一起做什么"
      placeholder-class="ph"
      bindinput="onTitleInput"
    />

    <view class="row-2">
      <view class="picker" bindtap="onOpenCat">
        <text class="t-hint">分类</text>
        <text class="picker-val">{{selectedCatName}}</text>
        <text class="picker-arrow">›</text>
      </view>
      <view class="btn-primary add" bindtap="onAdd">加入清单</view>
    </view>
  </view>

  <!-- 自定义分类 -->
  <view class="section-head">
    <text class="section-title serif">自定义分类</text>
    <text class="t-hint">{{customCats.length}} 个</text>
  </view>

  <view wx:if="{{customCats.length}}" class="card block">
    <view wx:for="{{customCats}}" wx:key="key" class="cat-row">
      <text class="cat-name">{{item.name}}</text>
      <text class="t-hint cat-count">{{item.count}} 件</text>
      <text
        class="cat-act"
        data-key="{{item.key}}"
        data-name="{{item.name}}"
        bindtap="onRenameCat"
      >改名</text>
      <text
        class="cat-act is-danger"
        data-key="{{item.key}}"
        data-name="{{item.name}}"
        data-count="{{item.count}}"
        bindtap="onDeleteCat"
      >删除</text>
    </view>
    <view class="cat-new" bindtap="onNewCat">＋ 新建分类</view>
  </view>

  <view wx:else class="card block">
    <text class="t-hint cat-empty">还没有自定义分类。点下面按钮新建，或在新建小事时从分类里现加一个。</text>
    <view class="cat-new" bindtap="onNewCat">＋ 新建分类</view>
  </view>

  <!-- 当前清单 -->
  <view class="section-head">
    <text class="section-title serif">当前清单</text>
    <text class="t-hint">{{items.length}} 件</text>
  </view>

  <view wx:if="{{items.length}}" class="card list">
    <view wx:for="{{items}}" wx:key="_id" class="row">
      <text class="no serif">{{item.noText}}</text>
      <view class="row-body">
        <text class="row-title">{{item.title}}</text>
        <text class="t-hint">{{item.categoryName}}</text>
      </view>
      <text
        class="del"
        data-id="{{item._id}}"
        data-title="{{item.title}}"
        data-status="{{item.status}}"
        bindtap="onDelete"
      >删除</text>
    </view>
  </view>
  <view wx:elif="{{loaded}}" class="empty">清单还是空的</view>

  <!-- 默认清单 -->
  <view class="section-head">
    <text class="section-title serif">默认清单</text>
    <text class="t-hint">还剩 {{library.length}} 件可加入</text>
  </view>

  <view wx:if="{{library.length}}" class="card block">
    <view class="lib-head" bindtap="toggleLibrary">
      <text class="t-sub">从默认小事库里挑，点一下加入</text>
      <text class="lib-toggle">{{showLibrary ? '收起' : '展开'}}</text>
    </view>

    <block wx:if="{{showLibrary}}">
      <view class="lib-actions">
        <view class="mini-btn" bindtap="onAddAllVisible">全部加入（{{library.length}}）</view>
      </view>
      <view class="lib-list">
        <view
          wx:for="{{library}}"
          wx:key="index"
          class="lib-row"
          data-index="{{item.index}}"
          bindtap="onPickDefault"
        >
          <text class="lib-title">{{item.title}}</text>
          <text class="lib-cat t-hint">{{item.categoryName}}</text>
          <text class="lib-plus">＋</text>
        </view>
      </view>
    </block>
  </view>
  <view wx:else class="empty">默认清单已经全部加入</view>

  <view class="foot-tip t-hint">内置 10 个分类不可修改，自定义分类可改名、可删除（需先移走里面的小事）</view>
</view>

<category-picker
  visible="{{catPickerVisible}}"
  list="{{catList}}"
  value="{{selectedCatKey}}"
  startInCreate="{{catPickerStartInCreate}}"
  bind:close="onCatPickerClose"
  bind:select="onCatSelect"
  bind:create="onCatCreate"
/>
