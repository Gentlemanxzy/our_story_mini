.page {
  padding-top: 24rpx;
}

.head {
  padding: 8rpx 0 32rpx;
}

.title {
  display: block;
  font-size: 52rpx;
  letter-spacing: 0.06em;
  color: var(--ink);
  margin-bottom: 10rpx;
}

.block {
  padding: 32rpx;
  margin-bottom: 28rpx;
  background: #FFFFFF;
}

.block-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.block-title {
  font-size: 30rpx;
  color: var(--ink);
  letter-spacing: 0.04em;
}

.code-box {
  height: 132rpx;
  border-radius: 16rpx;
  border: 1rpx dashed var(--line);
  background: var(--paper-2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.code {
  font-size: 60rpx;
  letter-spacing: 0.24em;
  color: var(--accent);
  padding-left: 0.24em;
}

.code-empty {
  height: 132rpx;
  border-radius: 16rpx;
  border: 1rpx dashed var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
}

.acts {
  display: flex;
  margin-top: 28rpx;
}

.flex1 {
  flex: 1;
}

.copy {
  width: 180rpx;
  margin-left: 20rpx;
}

.note {
  display: block;
  margin-top: 20rpx;
  line-height: 1.6;
}

/* 输入码 */
.code-input {
  height: 120rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--line);
  background: var(--paper-2);
  text-align: center;
  font-size: 52rpx;
  letter-spacing: 0.3em;
  color: var(--ink);
}

.code-ph {
  font-size: 26rpx;
  letter-spacing: 0.04em;
  color: var(--ink-3);
}

.tips {
  padding: 12rpx 8rpx;
}

.tips .t-hint {
  display: block;
  line-height: 2;
}
