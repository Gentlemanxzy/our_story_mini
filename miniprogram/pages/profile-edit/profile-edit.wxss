.page {
  padding-top: 48rpx;
}

/* ── 头像 ── */
.avatar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 40rpx;
}

/*
 * button 只作为点击区域 + open-type 载体：
 * 不设圆角与 overflow，避免把内部遮罩裁成「被啃掉两侧」的形状，
 * 也避免依赖 button 的 overflow 去裁剪 image（部分基础库不可靠）。
 */
.avatar-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: auto;
  max-width: 100%;
  padding: 0;
  margin: 0;
  background: transparent;
  border-radius: 0;
  overflow: visible;
  line-height: normal;
}

.avatar-circle {
  width: 176rpx;
  height: 176rpx;
  border-radius: 50%;
  overflow: hidden;
  /* border-box + 100% 的 image，避免图片溢出 2rpx 边框 */
  box-sizing: border-box;
  border: 1rpx solid var(--line);
  background: var(--paper-2);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.avatar-circle.is-empty {
  border-style: dashed;
  border-color: #DCD2C3;
}

.avatar-img {
  width: 100%;
  height: 100%;
  display: block;
  flex-shrink: 0;
}

.avatar-plus {
  font-size: 40rpx;
  line-height: 1;
  color: var(--ink-3);
}

.avatar-ph {
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 0.1em;
  margin-top: 8rpx;
}

.avatar-link {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--accent);
  letter-spacing: 0.04em;
}

.avatar-tip {
  margin-top: 14rpx;
  text-align: center;
}

/* ── 昵称 ── */
.field {
  padding: 28rpx;
  background: #FFFFFF;
}

.label {
  display: block;
  font-size: 24rpx;
  color: var(--ink-3);
  letter-spacing: 0.08em;
  margin-bottom: 14rpx;
}

.input {
  height: 92rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--line);
  background: var(--paper-2);
  font-size: 30rpx;
  color: var(--ink);
}

.ph {
  color: var(--ink-3);
  font-size: 26rpx;
}

/* ── 说明 ── */
.note {
  padding: 32rpx 8rpx 0;
}

.note .t-hint {
  display: block;
  line-height: 1.9;
}

.save {
  margin-top: 56rpx;
}
