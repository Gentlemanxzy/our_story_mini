<view class="page">
  <view class="avatar-wrap">
    <!-- button 只负责点击与 open-type，不再承担圆角裁剪 -->
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <view class="avatar-circle {{avatar ? '' : 'is-empty'}}">
        <image wx:if="{{avatar}}" class="avatar-img" src="{{avatar}}" mode="aspectFill" />
        <block wx:else>
          <text class="avatar-plus">＋</text>
          <text class="avatar-ph">头像</text>
        </block>
      </view>
      <text class="avatar-link">点头像可更换</text>
    </button>

    <text class="t-hint avatar-tip">可从微信头像里选，也可以从相册挑</text>
  </view>

  <view class="card field">
    <text class="label">昵称</text>
    <input
      class="input"
      type="nickname"
      value="{{nickName}}"
      maxlength="20"
      placeholder="点这里，键盘上方可选微信昵称"
      placeholder-class="ph"
      bindinput="onNickInput"
      bindblur="onNickInput"
    />
  </view>

  <view class="note">
    <text class="t-hint">· 微信自 2022 年 10 月起不再允许静默获取头像昵称，需你在这里主动确认一次</text>
    <text class="t-hint">· 头像会存到云端，换手机也在；未连云端时存在本机</text>
    <text class="t-hint">· 昵称头像随时可以回来改</text>
  </view>

  <view class="btn-primary save" bindtap="onSave">保存</view>
</view>
