<view class="page">
  <!-- 身份卡：点击进编辑资料 -->
  <view class="card identity" bindtap="goProfile">
    <image wx:if="{{avatar}}" class="avatar-img" src="{{avatar}}" mode="aspectFill" />
    <view wx:else class="avatar serif">{{initial}}</view>

    <view class="identity-body">
      <text class="nick serif">{{nickName || '还没起名字'}}</text>
      <text class="t-hint">{{statusText}}</text>
    </view>

    <view wx:if="{{!nickName}}" class="mini-btn">填资料</view>
    <text wx:else class="row-arrow">›</text>
  </view>

  <view class="counts">
    <view class="count-item">
      <text class="count-num serif">{{counts.total}}</text>
      <text class="count-label">件小事</text>
    </view>
    <view class="count-sep"></view>
    <view class="count-item">
      <text class="count-num serif accent">{{counts.done}}</text>
      <text class="count-label">已经珍藏</text>
    </view>
  </view>

  <!-- 菜单 -->
  <view class="card menu">
    <view class="row" bindtap="goProfile">
      <text class="row-label">头像与昵称</text>
      <text class="row-sub t-hint">随时可以改</text>
      <text class="row-arrow">›</text>
    </view>
    <view class="row" bindtap="goManage">
      <text class="row-label">管理小事</text>
      <text class="row-sub t-hint">增删 · 分类 · 排序</text>
      <text class="row-arrow">›</text>
    </view>
    <view class="row" bindtap="goBind">
      <text class="row-label">情侣绑定</text>
      <text class="row-sub t-hint">{{bound ? '查看对方' : '邀请码互绑'}}</text>
      <text class="row-arrow">›</text>
    </view>
    <view class="row" bindtap="onSyncTap">
      <text class="row-label">同步到云端</text>
      <text class="row-sub t-hint">{{pending > 0 ? pending + ' 条待上传' : '已同步'}}</text>
      <text class="row-arrow">›</text>
    </view>
    <view class="row" bindtap="onReset">
      <text class="row-label">重新体验首次引导</text>
      <text class="row-sub t-hint">清空清单数据</text>
      <text class="row-arrow">›</text>
    </view>
    <view class="row" bindtap="onAbout">
      <text class="row-label">关于</text>
      <text class="row-arrow">›</text>
    </view>
  </view>

  <view class="foot">
    <text class="t-hint">{{footText}}</text>
  </view>
</view>
